# ==============================================================================
# FLEET INTELLIGENCE SMART AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- APPLICATION & ENVIRONMENT ---
NODE_ENV="development" # development | staging | production
APP_ENV="development"
VITE_APP_ENV="development"
VITE_APP_NAME="Fleet Intelligence Smart AI"
VITE_API_BASE_URL="/api/v1"
PORT=3000
APP_URL="https://ais-pre-exmhluvhu5zv5jvc5k74ja-329463510306.asia-southeast1.run.app"

# --- AI SERVICES (Server-side Only) ---
# GEMINI_API_KEY: Configured securely via server secrets
GEMINI_API_KEY=""
AI_MODEL_TIER="gemini-2.5-flash" # gemini-2.5-flash | gemini-2.5-pro

# --- DATABASE & PERSISTENCE ---
# SUPABASE CONFIGURATION: Required for PostGIS spatial GPS telematics, PostgreSQL schema, & Auth
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL="postgresql://postgres:password@db.example.com:5432/fleet_intelligence"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT_MS=10000

# --- GPS HARDWARE INGESTION & PROTOCOLS ---
GPS_TCP_HOST="0.0.0.0"
GPS_TCP_PORT=5027
GPS_API_URL="/api/v1/gps/ingest"
MQTT_BROKER_URL="mqtts://broker.example.com:8883"
TELEMETRY_HOT_RETENTION_DAYS=30
TELEMETRY_COLD_RETENTION_DAYS=365

# --- REALTIME & WEBSOCKET ---
WEBSOCKET_URL="wss://stream.example.com/telemetry"
VITE_ENABLE_REALTIME="true"

# --- MAPS & SPATIAL PROVIDERS ---
GOOGLE_MAPS_PLATFORM_KEY=""
VITE_MAP_PROVIDER="leaflet" # google_maps | leaflet | mapbox

# --- OBJECT STORAGE (Documents, KIR, STNK, POD, Photos) ---
STORAGE_PROVIDER="supabase" # supabase | s3 | gcs | minio
STORAGE_ENDPOINT="https://storage.googleapis.com"
STORAGE_BUCKET="fleet-intelligence-documents"
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600

# --- NOTIFICATION PROVIDERS ---
EMAIL_PROVIDER="resend" # resend | sendgrid | ses
EMAIL_API_KEY=""
EMAIL_SENDER="fleet-alerts@fleetintelligence.id"

WHATSAPP_PROVIDER="twilio" # twilio | waba | wablas
WHATSAPP_API_KEY=""
WHATSAPP_SENDER_NUMBER="+6281234567890"

SMS_PROVIDER="telkomsel_sms" # telkomsel_sms | twilio
SMS_API_KEY=""

PUSH_NOTIFICATION_KEY="" # Firebase Cloud Messaging (FCM) Server Key

# --- SECURITY, SESSIONS & ENCRYPTION ---
JWT_SECRET=""
SESSION_SECRET=""
ENCRYPTION_KEY=""
SESSION_TTL_HOURS=24
API_RATE_LIMIT_PER_MINUTE=120
CORS_ORIGIN_WHITELIST="https://fleetintelligence.id,https://app.fleetintelligence.id"

# --- LOGGING & ERROR MONITORING ---
LOG_LEVEL="INFO" # DEBUG | INFO | WARN | ERROR | FATAL
ERROR_MONITORING_DSN=""
ENABLE_MOCK_DATA="false"
DEBUG="false"
